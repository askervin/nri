+// removeClosed drops plugins that closed while a request was running. The
+// write lock is taken only when there is something to drop.
+func (r *Adaptation) removeClosed() {
+	r.RLock()
+	closed := false
+	for _, p := range r.plugins {
+		if p.isClosed() {
+			closed = true
+			break
+		}
+	}
+	r.RUnlock()
+	if !closed {
+		return
+	}
+	r.Lock()
+	defer r.Unlock()
+	r.removeClosedPlugins()
+}
